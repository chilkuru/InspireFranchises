{
  "servers": {
    "testlink": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/testlink-mcp/index.js"
      ],
      "envFile": "${workspaceFolder}/testlink/.env",
      "env": {
        "TESTLINK_URL": "http://localhost:8080"
      }
    },
    "jenkins": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${workspaceFolder}/jenkins-mcp/index.js"
      ],
      "env": {
        "JENKINS_URL": "http://localhost:8090"
      }
    }
  }
}