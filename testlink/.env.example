# Copy this file to testlink/.env and fill in your values
# testlink/.env is gitignored — never commit the real file

# Base URL of your TestLink instance
# For the Docker stack in this repo: http://host.docker.internal:8080
TESTLINK_URL=http://host.docker.internal:8080

# Your TestLink API key
# Generate it: TestLink → admin → My Settings → API interface → Generate a new key
TESTLINK_API_KEY=your_api_key_here
